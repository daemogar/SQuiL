<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!--<DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>-->
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="**\Queries\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Basic.Reference.Assemblies.Net100" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Testcontainers.PostgreSql" />
		<PackageReference Include="Verify.DiffPlex" />
		<PackageReference Include="Verify.SourceGenerators" />
		<PackageReference Include="Verify.XunitV3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SQuiL.Core\SQuiL.Core.csproj" />
		<ProjectReference Include="..\SQuiL.SqlServer\SQuiL.SqlServer.csproj" />
		<ProjectReference Include="..\SQuiL.Sqlite\SQuiL.Sqlite.csproj" />
		<ProjectReference Include="..\SQuiL.Postgres\SQuiL.Postgres.csproj" />
		<!-- Referenced BOTH as a normal assembly (TestHelper's in-memory `new SQuiLGenerator(...)`
		     snapshot runs) AND as an Analyzer, so the generator ALSO runs at build time over this
		     project's own `**\Queries\*.sql` AdditionalFiles — producing REAL compiled contexts
		     (e.g. the Sqlite round-trip contexts in Sqlite\Queries). ReferenceOutputAssembly stays
		     true (default) so TestHelper still sees the SQuiLGenerator type. -->
		<ProjectReference Include="..\SQuiL.SourceGenerator\SQuiL.SourceGenerator.csproj" OutputItemType="Analyzer" />
		<ProjectReference Include="..\tools\GuideRenderer\GuideRenderer.csproj" />
	</ItemGroup>


	<ItemGroup>
		<!-- Pure version-compare logic from the SSMS extension, compiled into
		     the test assembly so it can be unit-tested without the VS SDK.
		     The Visual Studio extension keeps an identical hand-ported copy. -->
		<Compile Include="..\SQuiL.SsmsExtension\Update\SQuiLVersion.cs"
		         Link="ExtensionVersion\SQuiLVersion.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- The SSMS extension's editor-parsing/linting layer (SQuiLLinter, SQuiLParser, and
		     everything else under Parsing\) has zero VS SDK dependency (only System.*), so — same
		     pattern as SQuiLVersion.cs above — it's compiled directly into the test assembly rather
		     than referenced via ProjectReference (which would pull in the whole net472 VSSDK
		     project). This closes the "SQuiLLinter.cs has zero C# test coverage" gap flagged in the
		     Task 1 review's C2/round-2 fix (an uncaught ArgumentException from BuildKeyGraph's
		     downstream .ToDictionary went undetected specifically because nothing here could reach
		     these `internal` types before). Compiling the files in gives normal same-assembly
		     access to `internal` members without needing InternalsVisibleTo. The Visual Studio
		     extension keeps a byte-identical (modulo namespace) hand-ported copy of every file here
		     — this test coverage stands in for both mirrors; a future edit that only touches the VS
		     copy and skips the SSMS copy is still caught by the "byte-identical" diff check in
		     CLAUDE.md, not by this project. -->
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLParser.cs"
		         Link="ExtensionParsing\SQuiLParser.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLLinter.cs"
		         Link="ExtensionParsing\SQuiLLinter.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLDialect.cs"
		         Link="ExtensionParsing\SQuiLDialect.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SqlTypeMap.cs"
		         Link="ExtensionParsing\SqlTypeMap.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLContextResolver.cs"
		         Link="ExtensionParsing\SQuiLContextResolver.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLMutationScanner.cs"
		         Link="ExtensionParsing\SQuiLMutationScanner.cs" />
		<Compile Include="..\SQuiL.SsmsExtension\Parsing\SQuiLCodeActions.cs"
		         Link="ExtensionParsing\SQuiLCodeActions.cs" />
	</ItemGroup>

</Project>
