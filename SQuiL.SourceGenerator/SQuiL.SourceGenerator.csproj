<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace />
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsPackable>false</IsPackable>
		<Authors>Dæmogar</Authors>
		<Description>Source generator for turning SQL files into C# source code. Not published as its own NuGet package — SQuiL.Core packs this project's DLL into analyzers/dotnet/cs (see SQuiL.Core.csproj) so a single package provides both the analyzer and the runtime it depends on.</Description>
	</PropertyGroup>

	<!--
	SQuiL.Tests drives the parser directly and asserts on CodeBlock.TempScalarColumn — the
	single column preserved when a temp-table-header dialect collapses a one-column
	`Create Temp Table` into a scalar. It stays `internal`: SQuiL.Core ships this DLL as an
	analyzer, so making it public would be a permanent public-API commitment for what is
	purely a test's view of parser internals.
	-->
	<ItemGroup>
		<InternalsVisibleTo Include="SQuiL.Tests" />
	</ItemGroup>

	<!--
	This project is intentionally NOT packable (IsPackable=false above) — it has
	no PackageId and produces no .nupkg of its own. SQuiL.Core.csproj references
	this project (ReferenceOutputAssembly=false, build-order only) and packs its
	built DLL/PDB into analyzers/dotnet/cs, so a single package (SQuiL.Core)
	provides both the analyzer and the runtime it depends on. Keep this list in
	sync with SQuiL.Core.csproj — those PackageReferences now flow to consumers
	as real NuGet dependencies via that package, not by manual mirroring here.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>
</Project>